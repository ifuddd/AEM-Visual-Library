# Production Environment Variables for Vercel

# Backend (will be set in Vercel dashboard)
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-url.vercel.app
LOG_LEVEL=info

# Prototype mode - no database
USE_MOCK_DATA=true

# Azure AD - Not configured for prototype
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
